<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MapDriveWorker</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="[2.22.0]" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../server/physics/Program.cs" />
    <Compile Include="../../server/physics/CheckedInput.cs" />
    <Compile Include="../../server/physics/FractureResponse.cs" />
    <Compile Include="../../server/physics/InlineJobSystem.cs" />
    <Compile Include="../../server/physics/HandlingDiagnostics.cs" />
    <Compile Include="../../server/physics/TrackedHandling.cs" />
    <Compile Include="../../server/physics/AngularBodyBinding.cs" />
    <Compile Include="../../server/physics/AngularContactResponse.cs" />
    <Compile Include="../../server/physics/AngularFractureResponse.cs" />
    <Compile Include="../../server/physics/BattleScene.cs" />
    <Compile Include="../../server/physics/BattleSceneInput.cs" />
    <Compile Include="../../server/physics/BattleTank.cs" />
    <Compile Include="../../server/physics/ExtendedProfileQualification.cs" />
    <Compile Include="../../server/physics/ExtendedVehicleProfiles.cs" />
    <Compile Include="../../server/physics/StockProfileQualification.cs" />
    <Compile Include="../../server/physics/StockVehicleProfiles.cs" />
    <Compile Include="../../server/physics/TrackedBodySettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../server/physics/Profiles/stock-definitions.json" LogicalName="MapDrive.StockDefinitions" />
    <EmbeddedResource Include="../../server/physics/Profiles/extended-definitions.json" LogicalName="MapDrive.ExtendedDefinitions" />
  </ItemGroup>
</Project>
