<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../local/build/physics-coast-turn01/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(MSBuildThisFileDirectory)../../local/build/physics-coast-turn01/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../server/physics/*.cs" Exclude="../../server/physics/Program.cs" Link="Physics/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../server/physics/Profiles/stock-definitions.json" LogicalName="MapDrive.StockDefinitions" />
    <EmbeddedResource Include="../../server/physics/Profiles/extended-definitions.json" LogicalName="MapDrive.ExtendedDefinitions" />
    <PackageReference Include="JoltPhysicsSharp" Version="[2.22.0]" />
    <PackageReference Include="JoltPhysics.Native" Version="[1.1.0]" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
