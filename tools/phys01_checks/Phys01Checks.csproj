<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../local/build/phys01-checks/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(MSBuildThisFileDirectory)../../local/build/phys01-checks/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../server/physics/*.cs" Exclude="../../server/physics/Program.cs" Link="Physics/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../server/physics/Profiles/stock-definitions.json" LogicalName="MapDrive.StockDefinitions" />
    <EmbeddedResource Include="../../server/physics/Profiles/extended-definitions.json" LogicalName="MapDrive.ExtendedDefinitions" />
    <EmbeddedResource Include="../../server/physics/Profiles/generated-definitions.json" LogicalName="MapDrive.GeneratedDefinitions" />
    <EmbeddedResource Include="../../server/contracts/map_registry.json" LogicalName="MapDrive.MapRegistry" />
    <EmbeddedResource Include="../../server/physics/Profiles/reference-characteristics.json" LogicalName="MapDrive.ReferenceCharacteristics" />
    <EmbeddedResource Include="../../server/physics/Profiles/turret-shapes.json" LogicalName="MapDrive.TurretShapes" />
    <PackageReference Include="JoltPhysicsSharp" Version="[2.22.0]" />
    <PackageReference Include="JoltPhysics.Native" Version="[1.1.0]" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
