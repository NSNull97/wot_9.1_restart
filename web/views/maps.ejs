<%- include('partials/header') %>
<main id="main" class="shell catalog-page">
  <section class="catalog-hero map-catalog-hero"><div><a class="back-link" href="/">← На главную</a><p class="eyebrow">АТЛАС СТАЛЬНОГО РУБЕЖА / 0.9.1</p><h1>ЗНАКОМЫЕ МЕСТА.<br><em>НОВЫЕ РУБЕЖИ.</em></h1><p>Города, равнины и горные проходы.<br>Тот же рельеф эпохи — с собственными названиями.</p></div><div class="catalog-totals"><div><strong><%= counts.maps %></strong><span>карта в основном списке</span></div><div><strong><%= counts.mapsAll %></strong><span>локаций в архиве сборки</span></div></div></section>
  <div class="catalog-feature-links"><span>На знакомых направлениях</span><a href="/maps/05_prohorovka">Полевой разъезд →</a><a href="/maps/04_himmelsdorf">Градштейн →</a><a href="/maps/83_kharkiv">Морозоград →</a></div>
  <div class="catalog-layout"><aside class="metal-panel catalog-filters"><h2>НАЙТИ КАРТУ</h2><form method="get" action="/maps">
    <div class="field"><label for="map-search">Название</label><input id="map-search" name="q" type="search" value="<%= filters.q %>" maxlength="80" placeholder="Новое или прежнее название"><p class="field-hint">Поиск понимает и знакомые старые названия.</p></div>
    <div class="field"><label for="climate">Камуфляж</label><select id="climate" name="climate"><option value="">Все типы</option><% for(const [id,name] of Object.entries(climates)){ %><option value="<%= id %>" <%= filters.climate===id?'selected':'' %>><%= name %></option><% } %></select></div>
    <div class="field"><label for="terrain">Характер местности</label><select id="terrain" name="terrain"><option value="">Любая местность</option><% for(const [id,name] of Object.entries(terrains)){ %><option value="<%= id %>" <%= filters.terrain===id?'selected':'' %>><%= name %></option><% } %></select></div>
    <div class="field"><label for="mode">Режим в данных версии</label><select id="mode" name="mode"><option value="">Все режимы</option><% for(const [id,name] of Object.entries(modes)){ %><option value="<%= id %>" <%= filters.mode===id?'selected':'' %>><%= name %></option><% } %></select></div>
    <div class="field"><label for="scope">Коллекция</label><select id="scope" name="scope"><option value="main" <%= filters.scope==='main'?'selected':'' %>>Основной список · <%= counts.maps %></option><option value="reserve" <%= filters.scope==='reserve'?'selected':'' %>>Вне основного списка · 2</option><option value="special" <%= filters.scope==='special'?'selected':'' %>>Учебная и событийная · 2</option><option value="all" <%= filters.scope==='all'?'selected':'' %>>Все локации · <%= counts.mapsAll %></option></select></div>
    <button class="button full" type="submit">ПОКАЗАТЬ КАРТЫ →</button><a class="filter-reset" href="/maps">Сбросить фильтры</a>
  </form><p class="catalog-small">Названия изменены для Стального рубежа. Размеры и режимы взяты из выбранной сборки 0.9.1; ротация будущего сервера задаётся отдельно.</p></aside>
  <section class="catalog-results" aria-labelledby="maps-title"><div class="catalog-results-title"><h2 id="maps-title">АТЛАС КАРТ</h2><span>Найдено: <strong><%= total %></strong></span></div>
    <% if(filters.scope==='reserve'){ %><p class="catalog-notice">Описания этих локаций есть в сборке, но записи отсутствуют в её основном списке арен. Их доступность в боях не подтверждена.</p><% } %>
    <% if(!items.length){ %><div class="catalog-empty"><%- include('partials/icon',{name:'map'}) %><h3>Карт не найдено</h3><p>Измени название, фильтры или коллекцию.</p><a class="text-link" href="/maps?scope=all">Показать все локации →</a></div><% } %>
    <div class="map-grid"><% for(const map of items){ %><a class="map-card climate-<%= map.camouflage %>" href="/maps/<%= map.id %>">
      <% const art=mapImage(map); %><div class="map-card-art"><img class="map-thumbnail" src="<%= art.url %>" alt="Миникарта «<%= map.name %>»" width="<%= art.width %>" height="<%= art.height %>" loading="lazy" decoding="async"><span class="map-coordinate" aria-hidden="true">0.9.1 / <%= map.id.split('_')[0] %></span><span class="map-dimensions"><strong><%= format(map.size[0]) %> × <%= format(map.size[1]) %></strong><small>МЕТРОВ</small></span><span class="map-climate"><%= climates[map.camouflage] %></span></div>
      <div class="map-card-body"><p class="vehicle-class"><%= terrains[map.terrain] %><%= !map.registered?' · Вне списка':'' %></p><h3><%= map.name %></h3><p class="map-brief"><%= map.brief %></p><div class="mode-tags"><% for(const mode of map.modes){ %><span><%= modes[mode.id] %></span><% } %></div><span class="card-action">РАЗВЕДКА МЕСТНОСТИ <b aria-hidden="true">→</b></span></div>
    </a><% } %></div><%- include('partials/catalog-pagination') %><p class="catalog-footnote">Характер местности и тактические подсказки — редакционное описание. В карточке карты доступны миникарта, размеры, режимы и расположение баз по данным версии.</p>
  </section></div>
</main>
<%- include('partials/footer') %>
