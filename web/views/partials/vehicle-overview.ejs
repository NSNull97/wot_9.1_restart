<% const art=vehicleImage(vehicle),status=vehicleStatus(vehicle); const overviewTurret=research.selectedTurret || research.gunVariants[0]?.turret || vehicle.turrets[0]; const overviewGun=research.gunVariants[0]?.gun || overviewTurret.guns[0]; const mainShot=overviewGun.shots.find(s=>!s.premium) || overviewGun.shots[0]; const gunNode=research.nodes.find(n=>n.kind==='gun'&&n.key===overviewGun.key); %>
<section class="dossier-hero">
  <nav class="dossier-breadcrumbs" aria-label="Хлебные крошки"><a href="/">Главная</a><span>›</span><a href="/vehicles">Техника</a><span>›</span><a href="/vehicles?nation=<%= vehicle.nation %>"><%= nations[vehicle.nation] %></a><span>›</span><span><%= vehicle.name %></span></nav>
  <div class="dossier-hero-copy"><p class="nation-heading"><img class="nation-flag" src="<%= nationImage(vehicle.nation).url %>" alt="" width="27" height="17"><%= nations[vehicle.nation] %></p><h1><%= vehicle.name %></h1><p class="dossier-kind"><%- include('vehicle-class-icon',{vehicle}) %><span><%= classes[vehicle.class].toUpperCase() %> · <%= roman[vehicle.tier] %> УРОВЕНЬ</span></p><p class="dossier-status"><strong class="status-<%= status.kind %>"><%= status.label %></strong><span><%= status.description %></span></p><p class="dossier-role"><%= classRoles[vehicle.class] %></p><a class="button" href="#research"><%- include('tech-icon',{name:'gun'}) %>МОДУЛИ И ИССЛЕДОВАНИЕ</a></div>
  <figure class="dossier-hero-art"><%- include('vehicle-art',{art,vehicle}) %><figcaption><% if(art.kind==='upscaled-render'){ %>AI-апскейл оригинала · параметры 0.9.1<% } else if(art.donorName){ %>HD-рендер: <%= art.donorName %> · параметры 0.9.1<% } else { %><%= art.kind==='modern-render'?'Современный HD-рендер · параметры 0.9.1':art.kind==='contour'?'Архивный силуэт · версия 0.9.1':'Архивный рендер · версия 0.9.1' %><% } %></figcaption></figure>
  <div class="dossier-identity"><span><strong><%= roman[vehicle.tier] %></strong><small>УРОВЕНЬ</small></span><span><%- include('vehicle-class-icon',{vehicle}) %><small><%= classes[vehicle.class].toUpperCase() %></small></span><span><%- include('tech-icon',{name:'crew'}) %><small><%= vehicle.crew %> ЧЕЛОВЕК</small></span></div>
  <nav class="dossier-tabs" aria-label="Разделы досье"><a href="#overview">ОБЗОР</a><a href="#research">МОДУЛИ И РАЗВИТИЕ</a><a href="#armament">ВООРУЖЕНИЕ</a><a href="/vehicles">КАТАЛОГ ТЕХНИКИ</a></nav>
</section>
<section class="dossier-overview" id="overview" aria-label="Обзор характеристик">
  <section class="overview-panel"><h2><%- include('tech-icon',{name:'armor'}) %>ЖИВУЧЕСТЬ И ОБЗОР</h2><dl>
    <div><dt>Прочность</dt><dd><%= summary.hp %> <small>ед.</small></dd></div><div><dt>Броня корпуса</dt><dd><%= armorText(vehicle.hullArmor) %> <small>мм</small></dd></div><div><dt>Броня башни</dt><dd><%= armorText(overviewTurret.armor) %> <small>мм</small></dd></div><div><dt>Обзор</dt><dd><%= summary.view %> <small>м</small></dd></div><div><dt>Башен на выбор</dt><dd><%= vehicle.turrets.length %></dd></div></dl><p>Броня: лоб / борт / корма.<br>Башня: <%= overviewTurret.name %>.</p></section>
  <section class="overview-panel"><h2><%- include('tech-icon',{name:'aim'}) %>ОГНЕВАЯ МОЩЬ</h2><dl>
    <div><dt>Урон · <%= shellKinds[mainShot.kind] || mainShot.kind %></dt><dd><%= format(mainShot.damage) %> <small>ед.</small></dd></div><div><dt>Пробитие · <%= shellKinds[mainShot.kind] || mainShot.kind %></dt><dd><%= format(mainShot.penetration[0]) %> <small>мм</small></dd></div><div><dt>Перезарядка<%= overviewGun.magazine?' магазина':'' %></dt><dd><%= format(overviewGun.reloadTime) %> <small>с</small></dd></div><div><dt>Сведение</dt><dd><%= format(overviewGun.aimingTime) %> <small>с</small></dd></div><div><dt>Разброс на 100 м</dt><dd><%= format(overviewGun.dispersion) %> <small>м</small></dd></div></dl><p><a href="?module=<%= gunNode.id %>#module-info"><%= overviewGun.name %> ↗</a><br>С башней <%= overviewTurret.name %>.</p></section>
  <section class="overview-panel"><h2><%- include('tech-icon',{name:'speed'}) %>ПОДВИЖНОСТЬ</h2><dl>
    <div><dt>Макс. скорость</dt><dd><%= format(vehicle.speed.forward) %> <small>км/ч</small></dd></div><div><dt>Задний ход</dt><dd><%= format(vehicle.speed.backward) %> <small>км/ч</small></dd></div><div><dt>Мощность двигателя</dt><dd><%= summary.power %> <small>л. с.</small></dd></div><div><dt>Поворот ходовой</dt><dd><%= range(research.nodes.filter(n=>n.kind==='chassis').map(n=>n.rotation)) %> <small>°/с</small></dd></div><div><dt>Радиосвязь</dt><dd><%= range(vehicle.radios.map(r=>r.range)) %> <small>м</small></dd></div></dl><p>Диапазоны зависят от модулей.<br>Параметры версии 0.9.1.</p></section>
  <section class="overview-panel crew-overview"><h2><%- include('tech-icon',{name:'crew'}) %>ЭКИПАЖ И МОДУЛИ</h2><div class="crew-silhouettes" aria-label="Членов экипажа: <%= vehicle.crew %>"><% for(let i=0;i<vehicle.crew;i++){ %><span><%- include('icon',{name:'account'}) %></span><% } %></div><dl><div><dt>Экипаж</dt><dd><%= vehicle.crew %> <small>чел.</small></dd></div><div><dt>Модулей</dt><dd><%= research.moduleCount %></dd></div><div><dt>Орудий</dt><dd><%= summary.gunCount %></dd></div><% if(research.price){ %><div><dt>Стоимость машины</dt><dd><%= format(research.price.amount) %> <small><%= research.price.currency==='gold'?'зол.':'кр.' %></small></dd></div><% } %></dl><a class="overview-tree-link" href="#research">К ДЕРЕВУ ИССЛЕДОВАНИЯ →</a></section>
</section>
<p class="overview-note">Базовые параметры без бонусов экипажа и оборудования. Огневая мощь показана для указанного орудия и башни; выбор модуля обновляет эту связку.</p>
