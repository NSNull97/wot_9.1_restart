<% const artAlt=art.donorName?`Изображение ${art.donorName} для ${vehicle.name}`:`Изображение ${vehicle.name}`; if(art.viewBox){ %><svg class="tank-render" viewBox="<%= art.viewBox.join(' ') %>" role="img" aria-label="<%= artAlt %>"><image href="<%= art.url %>" width="<%= art.width %>" height="<%= art.height %>"/></svg><% } else { %><img class="tank-render" src="<%= art.url %>" alt="<%= artAlt %>" width="<%= art.width %>" height="<%= art.height %>" loading="lazy" decoding="async"><% } %>
